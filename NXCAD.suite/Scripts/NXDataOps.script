(**
@HandlerName: readPrdNumAndRev
@Author : Himaja
@HandlerDescription : 
**)
to readPrdNumAndRev partName
	try
		
		NXDataOps.openMysession
		NXDataOps.waitForLoading
		set the TextStyle to {DPI:144}
		put common.isTextPresentInSearchRect ("ENOVIA MySession",40,yes,getSearchRect(NXDisplay)) into textLoc
		set the TextStyle to empty
		Put textLoc + [-140,-30] into loc1
		Put textLoc + [600,650] into loc2
		log readtext(loc1,loc2)
		put common.IsImagePresentOnScreen ("icons/icn_Part",30,[loc1,loc2],yes) into loc
		EnoviaSearch.selectRightClickOptions loc,"Properties",,,
		NXDataOps.waitForLoading
		put common.isTextPresentInSearchRect ("Attributes",70,yes,getSearchRect(NXDisplay)) into textLoc
		Put textLoc + [-140,-30] into loc1
		Put textLoc + [600,500] into loc2
		log readtext(loc1,loc2)
		set the searchrectangle to [loc1,loc2]
		put common.TodoTripleClickWRTText( "Name",220,0,15) into prdNum
		common.success "Read PrdNum for part:"&partName&&"is :"&prdNum
		put common.TodoTripleClickWRTText( "Revision",220,0,15) into revNum
		common.success "Read RevNum for part:"&partName&&"is :"&revNum
		set the searchrectangle to empty
		(*wait 2
		typetext altKey,f4
		wait 2*)
		
		NXDataOps.closePropertiesPage
		NXDataOps.waitForLoading
		set the TextStyle to {DPI:144}  --to close properties window
		put common.isTextPresentInSearchRect ("ENOVIA MySession",40,yes,getSearchRect(NXDisplay)) into textLoc
		set the TextStyle to empty
		(*wait 5
		typetext altKey,f4 -- to close mysession window
		wait 4*)
		
		NXDataOps.closeMysession
		
		repeat until not imagefound(text:"ENOVIA MySession",waitfor:6,SearchRectangle:getSearchRect(NXDisplay),DPI:144)
			wait 2
			if repeatindex() is greater than 7
				common.error "ENOVIA MySession Window not closed"
				NXDataOps.closeMysession
				wait 10
				exit repeat
			end if
		end repeat
		common.CaptureScreenshot "ENOVIA MySession is closed or open"
		
		return [prdNum,revNum]
	Catch theException
		"exceptionHandling".failedHandlerNavigation(callStack())
		"exceptionHandling".errorCapture theException
	End try
end readPrdNumAndRev


(**
@HandlerName: readPrdNumAndRev
@Author : Himaja
@HandlerDescription : 
**)
to closeAllParts
	try
		if ImageFound(text:"File",searchRectangle:getSearchRect(toolBarArea),waitfor:60)
			Click FoundImageLocation()
			common.success "File Selected"
			common.ClickBtnByText  "Close", 30,getSearchRect(fileActionsArea),yes
			common.isTextPresentInSearchRect "All Parts",60,yes,getSearchRect(closeOptions)  
			Click FoundImageLocation()
			
			if imagefound(text:"Do you really want to save and close all parts",waitfor:40,searchRectangle:getSearchRect(NxDisplay))
				click FoundImageLocation()
				common.success "Saved and Closed all parts"
				wait 2
				typetext returnkey
				wait 4
			end if
		else
			common.error "File is not found",yes
		end if 
	Catch theException
		"exceptionHandling".failedHandlerNavigation(callStack())
		"exceptionHandling".errorCapture theException
	End try
end closeAllParts

(**  waitForLoading - Waits for the Loading Dialogue to disappear **) 
to waitForWorkInProgress SR:getSearchRect(workInProgress)
	try
		//repeat while imagefound(text:"Click Stop to interrupt", searchRectangle:SR, waitfor:2)
		repeat while imagefound(image:"icons/icn_wrkInProgress", searchRectangle:SR, waitfor:10)
			wait 2
			if repeatindex() is greater than 300
				//common.error "The application failed Save"
				common.error "The application failed Save"
				exit repeat
			end if
		end repeat
		
	Catch theException
		"exceptionHandling".failedHandlerNavigation(callStack())
		"exceptionHandling".errorCapture theException
	End try
end waitForWorkInProgress

(**
@HandlerName: closeInformationWindow
@Author : Himaja
@HandlerDescription : 
**)
to closeInformationWindow
	try
	(*if imagefound(text:"Information",waitfor:7,SearchRectangle:getSearchRect(rightHalfNxDisplay)) or imagefound(image:"icons/info_Edit",waitfor:6,SearchRectangle:common.commonScreenPart(RightHalf))
			
			common.ClickBtnByImage "icons/bt_Close", 7,getSearchRect(rightHalfNxDisplay),yes
			//typetext altKey,f4
		else
			if imagefound(Image:"icons/bt_Close",waitfor:3,SearchRectangle:getSearchRect(rightHalfNxDisplay))
				click FoundImageLocation()
				common.CaptureScreenshot
				
			end if 
		end if *)
		
		if imagefound(image:"icons/info_Edit",waitfor:6,SearchRectangle:common.commonScreenPart(RightHalf))
			
			common.ClickBtnByImage "icons/bt_Close", 7,getSearchRect(rightHalfNxDisplay),yes
			//typetext altKey,f4
		else
			if imagefound(Image:"icons/bt_Close",waitfor:3,SearchRectangle:getSearchRect(rightHalfNxDisplay))
				click FoundImageLocation()
				common.CaptureScreenshot
				
			end if 
		end if
		
		repeat while imagefound((*image:"icons/info_Edit",*)text:"Information",waitfor:6,SearchRectangle:getSearchRect(rightHalfNxDisplay))
			wait 1
			if repeatindex() is greater than 4
				common.error "Info Window not closed"
				exit repeat
			end if
		end repeat
		common.CaptureScreenshot "infowindow"
	Catch theException
		"exceptionHandling".failedHandlerNavigation(callStack())
		"exceptionHandling".errorCapture theException
	End try
end closeInformationWindow


(**
@HandlerName: waitfor3DEXPprocessing
@Author : Himaja
@HandlerDescription : 
**)
to waitfor3DEXProcessing
	try
		wait 2
		repeat while imagefound(text:"3DEXPERIENCE Progress",waitfor:6,SearchRectangle:getSearchRect("NXDisplay"))
			wait 1
			if repeatindex() is greater than 4
				common.error "Info Window not closed"
				exit repeat
			end if
		end repeat
		common.CaptureScreenshot "3DEXPERIENCE Progress"
		
	Catch theException
		"exceptionHandling".failedHandlerNavigation(callStack())
		"exceptionHandling".errorCapture theException
	End try
end waitfor3DEXProcessing


(**
@HandlerName: waitForLoading
@Author : Himaja
@HandlerDescription : 
**)
(**  waitForLoading - Waits for the Loading Dialogue to disappear **) 
to waitForLoading 
	//set screenRectangle1 to configEnovia[].searchRectangles.loadingDialogue
	try
		wait 4
		//repeat while imagefound(text:"Loading", waitfor:5 ,searchRectangle:screenRectangle)
		//repeat until not imagefound(text:"Loading", waitfor:5 ,SearchRectangle:[566,254,1479,849])
		repeat until not imagefound(image:"icons/Loading_Data", waitfor:5 ,SearchRectangle:[566,254,1479,849])
			wait 1
			if repeatindex() is greater than 100
				common.Error "The application failed to load",yes
				exit repeat
			end if
		end repeat
		
	Catch theException
		"exceptionHandling".failedHandlerNavigation(callStack())
		"exceptionHandling".errorCapture theException
	End try
end waitForLoading

(**
@HandlerName: waitForLoading
@Author : Himaja
@HandlerDescription : 
**)
to processOkDilouge
	try
		repeat until not imagefound(Image: "icons/ok_Warning",waitfor:10,SearchRectangle:getSearchRect(NXDisplay))
			wait 1
			if imagefound(Image: "icons/ok_Warning",waitfor:3,SearchRectangle:getSearchRect(NXDisplay))
				put readtext(getSearchRect(NXDisplay)) into readWarnings
				common.success "Ok button found with a warning - "&readWarnings&&"iteration -"&repeatindex()
				click FoundImageLocation()
			end if
			if repeatindex() is greater than 10
				common.success "unable to find ok warnings"
				exit repeat
			end if
		end repeat
		
		
	Catch theException
		"exceptionHandling".failedHandlerNavigation(callStack())
		"exceptionHandling".errorCapture theException
	End try
end processOkDilouge