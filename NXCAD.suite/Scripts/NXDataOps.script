		if imagefound(image:"MySession_Close",waitfor:20,searchRectangle:getSearchRect(mysessionWindow))
			click FoundImageLocation()
			common.success "Mysession found and closed"
		else
			Common.error "Mysession not found /closed",yes
		end if
	Catch theException
		"exceptionHandling".failedHandlerNavigation(callStack())
		"exceptionHandling".errorCapture theException
	End try
end closeMysession

