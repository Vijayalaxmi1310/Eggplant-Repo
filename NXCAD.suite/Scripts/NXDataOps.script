function getSearchRect Portion
	//set up an easy-to-maintain property list that stores the necessary multipliers for the specified screen portion parameter value
	Set screenPortions to {
		toolBarArea:[0,26,1608,153],
		topHalfScreen:[20,5,1919,537],
		fileActionsArea:[0,49,209,584],
		fileActionsExtensionArea:[198,56,734,591],
		fileExplorerArea:[11,0,966,986],
		NXDisplay:[338,174,1872,996],
		threeDXOptionsArea:[2,53,1550,134],
		closeOptions:[203,53,773,633],
		saveBtnPopup:[1051,432,1877,1015],
		workInProgress:[336,842,630,1024],
		rightHalfNxDisplay:[1039,129,1917,1006],
		loadingTextArea:[566,254,1479,849],
		mysessionWindow:[329,138,1865,619]

	}
	set multiplier to screenPortions.(Portion) //retrives the value for the key in the property list. the name of the key is passes as a parameter into the function.
	//test
	// Error handling is needed in the event that an unrecognized parameter is passes to the function
	set searchRectangle to screenPortions.(Portion)
	return searchRectangle 
End getSearchRect

(**
@HandlerName: openFileAndPart
@Author : Himaja
@HandlerDescription : 
**)
to openFileAndPart partName
	try
		if ImageFound(text:"File",searchRectangle:getSearchRect(toolBarArea),waitfor:60)
			Click FoundImageLocation()
			common.success "File Selected"
			common.ClickBtnByText  "Open", 30,getSearchRect(fileActionsArea),yes
			common.isTextPresentInSearchRect "File name",60,yes,getSearchRect(fileExplorerArea)   
			//set partName to "1205-1354_B.prt"
			typetext partName
			wait 5
			common.CaptureScreenshot
			typetext returnKey
			waitfor3DEXProcessing
			
			if imagefound(text:"Don't display this message again",waitfor:10,SearchRectangle:getSearchRect(NXDisplay) )
				click FoundImageLocation()
				typetext returnKey
			end if 
			
			(*repeat 7 times
				if imagefound(Image: "icons/ok_Warning",waitfor:4,SearchRectangle:getSearchRect(NXDisplay))
					put readtext(getSearchRect(NXDisplay)) into readWarnings
					common.success "Ok button found with a warning - "&readWarnings&&"iteration -"&repeatindex()
					click FoundImageLocation()
				end if
			end repeat*)
			NXDataOps.processOkDilouge
			
			if imagefound(text:"View",searchRectangle:getSearchRect(toolBarArea),waitfor:40)
				common.success "Part Opened successfully"
			else if imagefound(text:"Don't display this message again",waitfor:30,SearchRectangle:getSearchRect(NXDisplay) )
				common.success "Don't display this message again is displayed"
				click FoundImageLocation()
				typetext returnKey
				wait 2
				
			else if imagefound(text:"Don't display this message again",waitfor:60,SearchRectangle:getSearchRect(NXDisplay) )
				common.success "Don't display this message again is displayed"
				click FoundImageLocation()
				typetext returnKey
				wait 3
			else
				common.error "Unable to open Part",yes
			end if
			
			put common.isTextPresentInSearchRect ("View",40,yes,getSearchRect(toolBarArea)) into flagLoc
			if flagLoc is not empty or flagLoc is not "flagLoc"
				common.success "Part Opened successfully"
			else
				common.error "Unable to open Part",yes
			end if
		else
			common.error "Unable to find text File",yes
		end if
		
	Catch theException
		"exceptionHandling".failedHandlerNavigation(callStack())
		"exceptionHandling".errorCapture theException
	End try
end openFileAndPart



(**
@HandlerName: savePart
@Author : Himaja
@HandlerDescription : 
**)
to savePart partName
	try
		set status to empty
		common.ClickBtnByText "Active",40,getSearchRect(threeDXOptionsArea),yes
		
		/// Code if the model is already saved
		-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- 
		if imagefound(text:"No models need to be saved",waitfor:20,SearchRectangle:getSearchRect(NXDisplay))
			typetext returnKey
			wait 4
			common.success "Model pre-saved/pre-migrated"
			set status to "Pre-Migrated"
			log "Status is set to Pre-Migrated"
			closeInformationWindow
			return status
		else
			---- to handle popups
			NXDataOps.processOkDilouge
		end if
		-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- 
		
		
		/// Code for part to saved
		if imagefound(text:"3DEXPERIENCE Save Active",waitfor:120,SearchRectangle:getSearchRect(NXDisplay))
			//"Work in Progress"
			waitForWorkInProgress
			common.ClickBtnByText "Save",30,getSearchRect(saveBtnPopup),yes
			waitForWorkInProgress
			repeat 3 times
				if imagefound(Image: "icons/ok_Warning",waitfor:5,SearchRectangle:getSearchRect(NXDisplay))
					put readtext(getSearchRect(NXDisplay)) into readWarnings
					common.success "Ok button found with a warning - "&readWarnings&&"iteration -"&repeatindex()
					click FoundImageLocation()
				end if
			end repeat
			
			if imagefound(text:"Physical product",waitfor:30,SearchRectangle:getSearchRect(NXDisplay))
				common.success "Successfull saved part"&&partName
				set status to "Migration Pass"
				log "Status is set to Migration Pass"
				-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- 
				-- close opened windows
				wait 3
				typetext altkey,f4
				wait 3
				closeInformationWindow
				-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- 
			else
				put errorAndCaptureFailure (partName) into status
			end if
		else
			put errorAndCaptureFailure (partName) into status
		end if 
		return status
	Catch theException
		"exceptionHandling".failedHandlerNavigation(callStack())
		"exceptionHandling".errorCapture theException
	End try
end savePart


to errorAndCaptureFailure partName
	try
		common.error "unable to save Part due to some failures and continues with next data"
		delete ".prt" from partName
		capturescreen "Failed for Part "&&partName
		set status to "Migration Failed"
		log "Status is set to Migration Failed"
		processOkDilouge
		closeInformationWindow
		closeAllParts
		NXLaunch.switchTo3DX
		return status
	Catch theException
		"exceptionHandling".failedHandlerNavigation(callStack())
		"exceptionHandling".errorCapture theException
	End try
end errorAndCaptureFailure

(**
@HandlerName: openMysession
@Author : Himaja
@HandlerDescription : 
**)
to openMysession
	try
		
		if imagefound(text:"MySession",waitfor:20,searchRectangle:getSearchRect(threeDXOptionsArea))
			click FoundImageLocation()
			common.success "Mysession found and clicked"
		else
			Common.error "Mysession not found",yes
		end if
		
	Catch theException
		"exceptionHandling".failedHandlerNavigation(callStack())
		"exceptionHandling".errorCapture theException
	End try
end openMysession
(**
@HandlerName: closeMysession
@Author : Himaja
@HandlerDescription : 
**)
to closeMysession
