// Scripts will often rely on Excel files for test data or necessary data outside of Eggplant
// Add some break points to step through code and see how SenseTalk is working

(* Section 1: Defining Database Connection *)
(* Setting up the connection to an Excel file. *)
log "Defining the database connection information"
set myDB to {type:"excel", file:resourcePath("TestExcelDB.xlsx")}
// Access the People worksheet of the workbook as a table
log "Accessing the People worksheet"
put table "People" of myDB into peopleTable
// Fetch a specific record from the People table
log "Fetching the record for Shorty"
put the record of peopleTable where name is "Shorty" into shortyRecord
log shortyRecord
// Update Shorty's height
log "Updating Shorty's height to 42"
put 42 into shortyRecord's height
log shortyRecord
log shortyRecord is a record
log "Allowing Eggplant to write to the excel file"
set myDB to {type:"excel", file:resourcePath("TestExcelDB.xlsx"), writable:Yes}
log "Setting Shorty's height to 5"
put 5 into shortyRecord's height -- set it back to another value.
log shortyRecord
log "Now setting Shorty's height to 42"
put 42 into shortyRecord's height
log shortyRecord
log shortyRecord is a record
log "Setting Shorty's height to 39"
put 39 into shortyRecord's height -- set it back to another value.

put - // used to divide the sections of the script

(* Section 2: Accessing Worksheets *)
(* Accessing different worksheets by name or number. *)
log "Accessing the People worksheet by name"
put table "People" of myDB into peopleTable
// Access the Pets worksheet by number
log "Accessing the Pets worksheet by number"
put table 2 of myDB into petsTable
log "First record of Pets table:"
log the first record of petsTable
// Access the States worksheet by name and select a specific record
log "Accessing the States worksheet and fetching record for Colorado"
log record of table "States" of myDB where state is "Colorado"

put - // used to divide the sections of the script

(* Section 3: Shortcuts for Accessing Data *)
(* Using shortcuts to quickly access data from the database. *)
log "Using shortcuts to access data"
set myDB to {type:"excel", file:resourcePath("TestExcelDB.xlsx")}
// Simple way to get all records at once
log "Fetching all records from the database"
log the records of myDB
(* A table object is needed if you want to use table properties like columnsToFetch. *)
put
log "Fetching specific columns (name, hobby) from table 1"
put table 1 of myDB into tableOne
set tableOne's columnsToFetch to ["name", "hobby"]
log the records of tableOne

put - // used to divide the sections of the script

(* Section 4: Working with CSV Files *)
(* Defining and using a CSV file as a database. *)
log "Defining the database connection information for a CSV file"
set capitalsDB to {
    type:"csv",
    file:resourcePath("capitals.txt"),
    delimiter:"#", // must be a single character
    trimValues:Yes,
    -- allowEscapes:Yes,
    -- ignoreComments:Yes,
    -- writable:Yes
}
// A CSV file is always treated as a single table
// If needed, you can access table 1
log "Accessing table 1 of the CSV file"
put table 1 of capitalsDB into capitalsTable
log the recordInfo of capitalsTable ,,
// Fetch a specific record
log "Fetching record for United States"
set US to the record of capitalsDB where country contains "United States"
log US

put - // used to divide the sections of the script

(* Section 5: Adding Records to a CSV File *)
(* How to add new records to a CSV file. *)
log "Adding records to a CSV file"
set capitalsDB to {
    type:"csv",
    file:resourcePath("capitals.txt"),
    delimiter:"#", // must be a single character
    trimValues:Yes,
    writable:Yes // Set so you can add to the file
}
log "Number of records before adding: " & the number of records in capitalsDB
set newEntries to [
    {country:"Nowhere", capital:"Nowhere City"},
    {country:"Nothing Land", capital:"Nothingville"},
]
add records newEntries to capitalsDB
log "Number of records after adding: " & the number of records in capitalsDB

put - // used to divide the sections of the script

(* Section 6: Deleting Records from a CSV File *)
(* Methods to delete records from a CSV file. *)
log "Deleting records from a CSV file"
log "Number of records before deletion: " & the number of records in capitalsDB
// Fetch a record and then delete it
log "Fetching and deleting record for Canada"
put record of capitalsDB where country is "Canada" into canadaRec
delete record canadaRec
log "Number of records after deleting Canada: " & the number of records in capitalsDB
// Delete records specified by where clause
log "Deleting records where capital is Vienna"
delete records from capitalsDB where capital is "Vienna"
log "Number of records after deleting Vienna: " & the number of records in capitalsDB
// Reset to Zero State
log "Restoring records for Canada and Austria"
set RestoreCountries to [
    {Country:"Canada", capital: "Ottawa"},
    {Country:"Austria", capital:"Vienna"}
]
add records RestoreCountries to capitalsDB

log "End of Excel Demo"
