set myData to {
	v1:["v11","v12"],
	v2:["v21"],
	v3:["v33"]
}

getProductConfigValues {v1:["v11","v12"],v2:["v21"],v3:["v33"]}





to handle getProductConfigValues myData
	set myKeys to keys of myData
	
	repeat with each item myKey in myKeys
		
		Log "Current Key: " & myKey
		
		-- Click the textbox for the key
		log myKey
		
		put imageLocation(text:myKey) into myKeyCord
		set the searchRectangle to [[myKeyCord.x-30,myKeyCord.y+5],[myKeyCord.x+400,myKeyCord.y+30]]
		wait 5
		click text: "Type to"
		
		-- Get values for this key
		set myValues to myData.(myKey)
		
		repeat with each item myValue in myValues
			
			Log "Current Value: " & myValue
			typetext myValue,returnKey
			wait 1
			if imageFound(text:myvalue) then Log "Variant Values added"
			
		end repeat
		
	end repeat
end getProductConfigValues
*)
