(*
function GetValues myData, myKey:[]
	put myKey as a propertylist into myKey
	
	repeat with each key of myKey
		return myData.(myKey)
	end repeat
	
end GetValues

set myData to {v1:["v11","v12"], v2:["v21"], v3:["v33"]}

set result to GetValues(myData, "v2")

Log result
repeat with each value of result
	log value
end repeat


---------------
function SelectValues myData

repeat with each key myKey of myData

set myValues to myData.(myKey)
log myValues

repeat with each item theValue in myValues
	Log "Key: " & myKey & " Value: " & theValue
	log theValue
end repeat

end repeat

end SelectValues

set myData to {v1:["v11","v12"], v2:["v21"], v3:["v33"]}

log SelectValues( myData)

