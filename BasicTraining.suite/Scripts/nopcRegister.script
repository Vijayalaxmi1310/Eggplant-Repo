(* Autosnippets for RadioButton "Female" (using OCR) *)

to handle Female_Select
	// Assumes the hot spot has been set over the radio button or 
	// that clicking on the center of the radio button label will select the radio button.
	
	Click Text:"Female", waitFor:8
end Female_Select

