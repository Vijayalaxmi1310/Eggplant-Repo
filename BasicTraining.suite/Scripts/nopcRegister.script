(* Autosnippets for Button "RegisterLink" *)

to handle RegisterLink_Click
    Click imageName:"RegisterLink", waitFor:8
end RegisterLink_Click

-----------------------------------


(* Autosnippets for Checkpoint "Your Personal" (using OCR) *)

to handle Your_Personal_Validate duration
    if duration is not a number then set duration to 8
    WaitFor duration, Text:"Your Personal"
end Your_Personal_Validate

to handle Your_Personal_IsFound duration
    if duration is not a number then set duration to 8
    return imageFound(Text:"Your Personal", waitFor:duration)
end Your_Personal_IsFound

